# Домен, на якому працюватиме застосунок (для Caddy та посилань у сповіщеннях)
DOMAIN=kadastr.example.com
PUBLIC_URL=https://kadastr.example.com

# Реєстрація: approval — заявка, яку підтверджує адмін (рекомендовано)
#             invite   — одразу активний, але потрібен INVITE_CODE
#             closed   — реєструє лише адмін (через manage.py)
# Перший зареєстрований користувач автоматично стає адміністратором.
REGISTRATION=approval
INVITE_CODE=

# Скільки днів живе вхід користувача (продовжується автоматично при використанні)
SESSION_DAYS=30
# false — тільки для локального тесту без HTTPS
COOKIE_SECURE=true

# Сповіщення про падіння сесії ЄДЕССБ (необов'язково).
# Бот: @BotFather → /newbot; chat id: напишіть боту, відкрийте
# https://api.telegram.org/bot<TOKEN>/getUpdates і візьміть chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
